# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
# Users configure this via the Secrets panel in the AI Studio UI.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
# Used for self-referential links, OAuth callbacks, and API endpoints.
APP_URL="MY_APP_URL"

# FIREBASE ADMIN CREDS: Service-account credentials for firebase-admin, used
# server-side only (never sent to the client). All three are required for
# Firestore to initialize; without them the server falls back to an
# in-memory store that does not persist across restarts. Generate these from
# a service account JSON key in the Firebase console (Project Settings ->
# Service Accounts -> Generate new private key).
FIREBASE_PROJECT_ID=""
FIREBASE_CLIENT_EMAIL=""
# Paste the key's "private_key" field as-is, including \n line-break escapes
# and the BEGIN/END PRIVATE KEY markers -- the server unescapes them at startup.
FIREBASE_PRIVATE_KEY=""

# FIRESTORE_COLLECTION_PREFIX: Namespaces this deployment's Firestore
# collections so multiple deployments (e.g. the original ART-Score and a
# duplicate like artscore1) can share one Firebase project without their
# data intermingling -- each gets its own sessions/attempts/etc, prefixed
# with this value. Leave blank for the original, unprefixed names.
# Rejects "/" , ".", "..", and Firestore's reserved __*__ pattern at startup.
FIRESTORE_COLLECTION_PREFIX=""

# ADMIN_KEYS: Comma-separated list of valid admin keys for the /api/system-prompt
# and /api/admin/attempts routes (sent via the X-Admin-Key header). Supports
# rotation: add a new key alongside the old one, migrate callers, then drop the
# old one -- no downtime. The legacy singular ADMIN_KEY (one key only) is still
# read as a fallback if ADMIN_KEYS is unset.
ADMIN_KEYS=""

# ADMIN_EMAIL: Optional second factor on admin sign-in. When set, the email
# entered on the /admin login form must match this as well as the password
# (which is one of ADMIN_KEYS above). Leave blank to check the key only.
ADMIN_EMAIL=""

# DAILY_GENERATION_CAP: Optional override for the per-process daily cap on new
# test sessions (/api/generate-task), a safety valve against cost blowouts from
# abuse or retry storms. Defaults to 500 if unset. Resets on process restart.
DAILY_GENERATION_CAP=""
